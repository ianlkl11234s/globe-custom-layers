// Cloudflare Workers 部署設定（取代 Zeabur nginx；Zeabur 2026-12 停運）
// 純靜態站：site/dist 由 npm run build:site 產生，沒有前端路由
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "globe-custom-layers",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site/dist",
    // 沒有前端路由，不存在的路徑回 404（同 nginx try_files ... =404）
    "not_found_handling": "none",
    // /examples/<id> 自動補結尾斜線（nginx 原本的 301 會帶錯 :8080 埠，這裡一併修正）
    "html_handling": "auto-trailing-slash"
  },
  "observability": { "enabled": true }
}
